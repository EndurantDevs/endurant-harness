{
  "name": "prove-change",
  "cwd": ".",
  "default_timeout": 120,
  "require_behavior_evidence": true,
  "stages": [
    {
      "name": "focused",
      "parallel": true,
      "commands": [
        {
          "id": "regression",
          "argv": [
            "pytest",
            "tests/test_target.py",
            "-q"
          ],
          "evidence": "behavior"
        },
        {
          "id": "lint-target",
          "argv": [
            "ruff",
            "check",
            "src/target.py"
          ],
          "evidence": "static"
        }
      ]
    },
    {
      "name": "affected-scope",
      "parallel": false,
      "commands": [
        {
          "id": "package-tests",
          "argv": [
            "pytest",
            "tests/package",
            "-q"
          ],
          "evidence": "integration"
        }
      ]
    },
    {
      "name": "diff",
      "run_if": "always",
      "parallel": true,
      "commands": [
        {
          "id": "diff-check",
          "argv": [
            "git",
            "diff",
            "--check"
          ],
          "evidence": "diff",
          "timeout": 30
        },
        {
          "id": "diff-stat",
          "argv": [
            "git",
            "diff",
            "--stat"
          ],
          "evidence": "diff",
          "timeout": 30
        }
      ]
    }
  ]
}
